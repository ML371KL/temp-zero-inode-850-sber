# Образец env-файла сервера /usr/local/etc/sber-850/env (root:dash, права 640).
# ЗДЕСЬ ТОЛЬКО ИМЕНА. Значения вписываются на сервере (sudoedit) и в репозиторий
# не попадают никогда: репозиторий публичный. Формат — KEY=value построчно, без
# пробелов вокруг `=` и без `export`: файл читает ops/run.sh (через `.`); юниты
# systemd его не читают (строки EnvironmentFile в них нет — иначе токен лежал бы
# в окружении всего юнита). Пустое обязательное значение — run.sh выходит с
# кодом 78, publish.py — с кодом 1 (и называет переменную).
# Что вписать — ops/README.md, раздел «Установка»; значения с доступами — в
# справочнике владельца вне репозитория.
#
# Имена (docs/INTERFACES.md §8): переменные ядра и индикаторов — без префикса
# банка (BANK_*): копия ядра под другой банк их не меняет; переменные только
# эксплуатации — с префиксом банка (SBER_*): слой ops у банка свой.

# Каталог кода (клон main, --single-branch, анонимный HTTPS) и состояние
# (StateDirectory юнитов). Оба обязательны.
SBER_REPO_DIR=
BANK_STATE_DIR=

# Клон ветки release репозитория данных (по умолчанию — data-repo в каталоге
# состояния; его же читает сборка: прошлый выпуск и история оценки). Задавать
# без нужды не надо. Каталог обязан быть своим: publish.py отказывает (код 1),
# если он совпадает с каталогом состояния или кода, лежит выше них, не пуст без
# .git или содержит чужой git-репозиторий, — и ничего в нём не трогает.
# BANK_DATA_REPO_DIR=

# Окружение Python 3.12 (по умолчанию — .venv в каталоге кода) и сам питон.
# Отметка установленных зависимостей живёт в venv: .venv/.requirements.sha256.
# SBER_VENV=
# SBER_PYTHON=

# Токен T-Invest «только чтение» (секрет: только здесь; в файлы, журналы и
# выпуски не пишется), выпущенный на отдельный счёт без активов, а не на
# основной счёт владельца. run.sh снимает его из окружения такта сразу после
# чтения этого файла и передаёт одной команде — сборщику T-Invest; остальные
# шаги такта идут без токена. Пусто — источник T-Invest отмечается
# отсутствующим (тревога без повтора), цены берутся с MOEX ISS.
TINVEST_TOKEN=

# Канал данных: адрес репозитория данных для клона и push — ssh-алиас ключа
# записи из ~/.ssh/config пользователя конвейера, вида
# <алиас>:<владелец>/<репозиторий данных>.git. Ключ и его путь сюда не пишутся.
SBER_RELEASE_REMOTE=

# Автор коммитов ветки release: имя и ТОЛЬКО noreply-адрес GitHub из списка
# .github/commit-emails.allow репозитория кода (метаданные коммитов публичного
# репозитория видны всем и навсегда). Другой адрес, в том числе чужой noreply, —
# publish.py отказывает (сверяет со списком).
SBER_GIT_NAME=
SBER_GIT_EMAIL=

# Боевая дверь, через которую читает браузер (сверка ходит именно сюда).
# Пусто — адрес по умолчанию из ops/publish.py.
SBER_PUBLIC_URL=

# Сверка: сколько ждать выпуск на двери и пауза между попытками, с (600 и 30);
# паузы между попытками push, с (10,30).
# SBER_VERIFY_TIMEOUT=
# SBER_VERIFY_PAUSE=
# SBER_PUSH_BACKOFF=

# Процессов полосы неопределённости: auto (ядра − 1, не больше 7) или число;
# 1 — без пула. Сервер общий: число вписывается ЯВНО после замера первых тактов
# (время сборки и пик памяти юнита против MemoryHigh/MemoryMax, ops/README.md §9);
# до замера auto на машине с 8 ядрами и больше подводит сборку к MemoryHigh.
# BANK_WORKERS=

# Прогон «в будущем» в утреннем такте: день недели (1 — понедельник) и сдвиг, дни.
# SBER_FUTURE_WEEKDAY=
# SBER_FUTURE_DAYS=

# Проба доставки тревоги задаётся не здесь, а временной вставкой юнита
# (ops/README.md §4): мост тревог зовётся только из ExecStopPost юнита, поэтому
# проба идёт через systemd —
#   Environment=SBER_SIMULATE_FAILURE=<невосполнимый источник утреннего такта>
# во вставке `systemctl edit --runtime sber850-collect.service`.
# BANK_HANDOFF_DIR (папка передачи) на сервере не задаётся.
