[Unit]
Description=Сбер 850 · таймер проверки нового кода в main (раз в 15 минут)

[Timer]
# Каждые 15 минут со сдвигом на 12-ю минуту: мимо ровных четвертей и пересборок
# соседних панелей. Проверка — один анонимный `git fetch` по HTTPS, секунды.
# После правки кода новый выпуск на витрине — через 15–25 минут плюс сборка
# GitHub Pages, а не вечером.
OnCalendar=*:12,27,42,57
RandomizedDelaySec=60
AccuracySec=30s
# Persistent не нужен: пропущенная проверка ничего не теряет — следующая
# увидит тот же новый код.
Unit=sber850-rebuild.service

[Install]
WantedBy=timers.target
